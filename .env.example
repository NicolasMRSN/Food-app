# Développement local (npm run dev) contre l'instance Supabase du homelab.
# En production (Docker), l'URL est la même origine que l'app et la clé est injectée au build.
VITE_SUPABASE_URL=http://192.168.1.192:8081
# Clé publique "anon" : ANON_KEY dans /srv/docker/food-app/.env sur le serveur
VITE_SUPABASE_ANON_KEY=
